# =============================================================
# Telegram Downloader Bot - Environment Variables (example)
# Copy to .env and fill in real values. NEVER commit secrets.
# =============================================================

# --- Telegram ---
BOT_TOKEN=123456789:AAH...   # required
ADMIN_IDS=123456789,987654321

# --- Limits ---
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_SIZE=50
MAX_FILE_SIZE_MB=1900          # Telegram Bot API limit
DOWNLOAD_TIMEOUT_SEC=1800      # per-job timeout
JOB_TTL_SEC=900                # dedupe TTL for repeated URLs

# --- Storage (Render-ready) ---
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
REDIS_URL=redis://localhost:6379/0

# --- yt-dlp tuning ---
YT_DLP_CONCURRENT_FRAGMENTS=4
YT_DLP_SOCKET_TIMEOUT=60
YT_DLP_RETRIES=5

# --- Logging ---
LOG_LEVEL=INFO
